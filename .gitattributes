# Configura Git para manejar los finales de línea de forma automática y consistente.
# Esto normalizará todos los archivos de texto a finales de línea LF en el repositorio.
* text=auto

# Para archivos específicos, podemos forzar el uso de LF (Line Feed), que es el estándar en entornos de servidor (Linux).
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.vue   text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.env*  text eol=lf

# Asegúrate de que los archivos binarios no sean modificados.
*.png   binary
*.jpg   binary